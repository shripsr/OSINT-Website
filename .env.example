# Copy this file to .env and fill in your own keys.
# .env is git-ignored and never sent to the browser.

# OpenSky API client (opensky-network.org -> account -> API client)
# Optional: without it the world view refreshes every 15 min instead of 90 s
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# AirLabs (airlabs.co) - optional, better flight routes
AIRLABS_API_KEY=

# aisstream.io - optional, ships worldwide
# (without it the ship layer covers Finland / the northern Baltic only)
AISSTREAM_API_KEY=

# Pelyr (pelyr.com) - optional, fills in the ships of the area on screen at once
# Free key: https://dashboard.pelyr.com/stream (non-commercial use only)
PELYR_API_KEY=

# VesselAPI (vesselapi.com) - optional backup, only used when aisstream and
# Pelyr both stop delivering (free plan: 150 requests a month)
VESSELAPI_KEY=

# Real GPS positions of transit vehicles (all optional; see server.py)
# TransLink, Metro Vancouver - free key: https://developer.translink.ca
TRANSLINK_API_KEY=
# Transitland - free key: https://www.transit.land (finds feeds for other areas)
TRANSITLAND_API_KEY=
# Mobility Database - free account at https://mobilitydatabase.org ; copy the
# "refresh token" from your account page (finds feeds for other areas)
MOBILITY_DATABASE_REFRESH_TOKEN=
