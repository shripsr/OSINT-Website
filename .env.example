# Copy this file to .env and fill in your own keys.
# .env is git-ignored and never sent to the browser.

# OpenSky API client (opensky-network.org -> account -> API client)
# Optional: without it the world view refreshes every 15 min instead of 90 s
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# AirLabs (airlabs.co) - optional, better flight routes
AIRLABS_API_KEY=
